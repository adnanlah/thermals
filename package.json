{
  "name": "thermal-webusb-receipts",
  "version": "1.0.0",
  "description": "TypeScript Node.js app for printing simple receipts to thermal printers over WebUSB.",
  "packageManager": "yarn@1.22.22",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "print": "tsx src/index.ts print",
    "print-arabic": "tsx src/index.ts print-arabic",
    "print-system": "tsx src/index.ts print-system",
    "print-arabic-system": "tsx src/index.ts print-arabic-system",
    "print-arabic-text-system": "tsx src/index.ts print-arabic-text-system",
    "print-arabic-raw-system": "tsx src/index.ts print-arabic-raw-system",
    "print-arabic-bitmap-system": "tsx src/index.ts print-arabic-bitmap-system",
    "print-arabic-canvas-system": "tsx src/index.ts print-arabic-canvas-system",
    "render-arabic-canvas-bitmap": "tsx src/index.ts render-arabic-canvas-bitmap",
    "print-arabic-puppeteer-system": "tsx src/index.ts print-arabic-puppeteer-system",
    "render-arabic-puppeteer-bitmap": "tsx src/index.ts render-arabic-puppeteer-bitmap",
    "list-system-printers": "tsx src/index.ts list-system-printers",
    "list-usb": "tsx src/index.ts list-usb",
    "inspect-printer": "tsx src/index.ts inspect-printer",
    "test-print": "tsx src/index.ts test-print",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "thermal-printer",
    "receipt",
    "webusb",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "@bwip-js/node": "^4.11.1",
    "canvas": "^3.2.3",
    "iconv-lite": "0.6.3",
    "node-thermal-printer": "^4.6.0",
    "puppeteer": "^25.1.0",
    "usb": "^2.15.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
